            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/memory/query/": {
      "post": {
        "tags": ["v1", "memory", "memory"],
        "summary": "Query Memory",
        "description": "Query a memory. This will return the most relevant context from the memory. You can also specify a conversation_id to get the history of the conversation.",
        "operationId": "query_memory_api_v1_memory_query__post",
        "parameters": [
          {
            "name": "X-LumenBrain-ApiKey",
            "in": "header",
            "required": true,

              "title": "Memory Uuid"
            },
            "description": "The UUID of the memory to query"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (starts from 1)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (starts from 1)"
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search query to filter records",
              "title": "Query"
            },
            "description": "Search query to filter records"
          },
          {
            "name": "types",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated list of types to filter by",
              "title": "Types"
            },
            "description": "Comma-separated list of types to filter by"
          },
          {
            "name": "X-LumenBrain-ApiKey",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "API Key for authentication",
              "title": "X-Lumenbrain-Apikey"
            },
            "description": "API Key for authentication"
          }
        ],
        "responses": {
          "200": {
            "description": "Memory records retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMemoryRecordsResponse"
                }
              }
            }
          },
